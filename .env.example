APP_NAME="WKY Inventory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wky_inventory
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Cakera untuk gambar invois dan gambar produk. Biarkan 'local' untuk
# pemasangan sendiri. Pada hos berkontena (Laravel Cloud, Fly, Render) tukar
# kepada 's3' dan isi AWS_* di bawah — cakera tempatan di situ selalunya
# dibina semula pada setiap deploy, dan gambar akan lenyap sedangkan rekodnya
# kekal. Jalankan `php artisan wky:semak-storan` untuk mengesahkannya.
MUAT_NAIK_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# PENTING: 'log' bermakna emel TIDAK dihantar — ia ditulis ke
# storage/logs/laravel.log sahaja. Ini selamat untuk pembangunan, tetapi pada
# produksi ia bermakna pautan "Lupa Kata Laluan" tidak pernah sampai kepada
# sesiapa, dan borang itu tetap berkata "pautan sudah dihantar".
#
# Untuk produksi, tukar kepada 'smtp' dan isi butiran pembekal emel anda:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.pembekal.com
#   MAIL_PORT=587
#   MAIL_SCHEME=tls
#   MAIL_USERNAME=...
#   MAIL_PASSWORD=...
# Kemudian sahkan dengan: php artisan wky:semak-emel anda@syarikat.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Imbas Invois (AI) - daftar di https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

# Pilihan; nilai di bawah ialah lalai. Naikkan had masa untuk invois berbilang
# halaman, dan saiz maksimum (KB) untuk gambar kamera beresolusi tinggi.
# ANTHROPIC_TIMEOUT=180
# ANTHROPIC_SAIZ_MAKS_KB=10240

# Log masuk Google - daftar di https://console.cloud.google.com/apis/credentials
# URI ubah hala yang dibenarkan: {APP_URL}/auth/google/callback
# Biarkan kosong untuk menyembunyikan butang "Teruskan dengan Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
